# 复制为 .env 后按需修改；compose 会自动读取本文件。
# 主机对外端口（容器内固定 8080）
PORT=8080
# 镜像标签
IMAGE_TAG=0.2.54
# 访问令牌：留空表示不校验；填上后除 /healthz 外的接口都要带 Authorization: Bearer <token>
TOKEN=
# 同时处理的请求数上限，1-64
MAX_CONCURRENCY=8
# 站源出网代理：留空表示不改动服务内已有设置；auto 读取系统代理，direct 直连，manual 用下面的地址
PROXY_MODE=manual
# 代理地址，支持 http / https / socks5 / socks5h；代理跑在宿主机上时用 host.docker.internal
PROXY_URL=http://host.docker.internal:7890
# 构建镜像时的 Go 模块代理
GOPROXY=https://goproxy.cn,direct
# 时区
TZ=Asia/Shanghai
